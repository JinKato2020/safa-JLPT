   "questions": [
    {
     "id": "N4-D-J-0002-q1",
     "q": "この人たちが全部ではらう金額は、いくらですか。",
     "choices": [
      "2,400円",
      "2,100円",
      "2,700円",
      "1,800円"
     ],
     "answerIndex": 1,
     "i18n": {
      "ja": {
       "explain": "水曜午前はEコース（大人1,200円・子ども600円）。大人1人＋子ども2人で1,200＋600×2＝2,400円。3名なのでお知らせの300円引きが使え、2,400−300＝2,100円が正解。「2,400円」は割引を読み落とした表のままの額。「2,700円」は割引を足し算してしまった額。「1,800円」は子どもを1人だけで数えた額。"
      }
     }
    }
   ],
