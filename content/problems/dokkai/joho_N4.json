   "questions": [
    {
     "id": "N4-D-J-0001-q1",
     "q": "この子どもが通えるコースは、どれですか。",
     "choices": [
      "そら",
      "うみ",
      "かぜ",
      "あめ"
     ],
     "answerIndex": 3,
     "i18n": {
      "ja": {
       "explain": "子どもは1年生で土曜の朝を希望。「あめ」は土9:30〜10:30・対象1〜2年生・受付中で条件に合う。「そら」は土朝だが対象が3年生以上（お知らせ）で外れる。「うみ」は土朝で対象も合うが今月で受付を止めていて（お知らせ）外れる。「かぜ」は土曜だが13時からの午後で時間が合わない。"
      }
     }
    }
   ],
   "skeleton": {
