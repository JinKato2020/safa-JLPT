{
  "schema": 1,
  "kind": "example",
  "level": "N5",
  "languages": [
    "ne"
  ],
  "items": {
    "n5-g-81": {
      "ne": "त्यो र्‍याकमा भएको मिठाई दिनुहोस्।"
    },
    "n5-g-82": {
      "ne": "अनि, त्यहाँ भेटौं।"
    },
    "n5-g-83": {
      "ne": "शौचालय कहाँ छ?"
    },
    "n5-g-84": {
      "ne": "यो क्यामेरा कति हो?"
    },
    "n5-g-85": {
      "ne": "उहाँ को हुनुहुन्छ?"
    },
    "n5-g-86": {
      "ne": "परीक्षा कहिले हो?"
    },
    "n5-g-87": {
      "ne": "हिजो मैले फिल्म हेरें।"
    },
    "n5-g-88": {
      "ne": "त्यो किताब मेरो हो।"
    },
    "n5-g-89": {
      "ne": "कृपया अलिकति पर्खनुहोस्।"
    },
    "n5-g-90": {
      "ne": "उनी डाक्टर हुन्।"
    },
    "n5-g-91": {
      "ne": "कृपया, भित्र आउनुहोस्।"
    },
    "n5-g-92": {
      "ne": "हिजो म विद्यालय गएँ।"
    },
    "n5-g-1": {
      "ne": "यहाँ फोटो खिच्न हुँदैन।"
    },
    "n5-g-2": {
      "ne": "यो किताब हो।"
    },
    "n5-g-3": {
      "ne": "पानी मात्र दिनुहोस्।"
    },
    "n5-g-4": {
      "ne": "भोलि घाम लाग्नेछ होला।"
    },
    "n5-g-5": {
      "ne": "म पुस्तकालयमा पढ्छु।"
    },
    "n5-g-6": {
      "ne": "यो महँगो छ। तर, म किन्छु।"
    },
    "n5-g-7": {
      "ne": "भोलि पानी पर्नेछ होला।"
    },
    "n5-g-8": {
      "ne": "तपाईंलाई कस्तो संगीत मन पर्छ?"
    },
    "n5-g-9": {
      "ne": "तपाईं किन स्कुल जानुभएन?"
    },
    "n5-g-10": {
      "ne": "तपाईं कसरी स्टेशन जानुहुन्छ?"
    },
    "n5-g-11": {
      "ne": "पानी परिरहेको छ।"
    },
    "n5-g-12": {
      "ne": "टेबलमा किताब छ।"
    },
    "n5-g-13": {
      "ne": "मलाई नयाँ गाडी चाहिएको छ।"
    },
    "n5-g-14": {
      "ne": "पार्कमा कुकुर छ।"
    },
    "n5-g-15": {
      "ne": "चाँडै सुत्नु राम्रो हुन्छ।"
    },
    "n5-g-16": {
      "ne": "यो किताब रमाइलो छ।"
    },
    "n5-g-17": {
      "ne": "फुजी हिमाल सबैभन्दा अग्लो छ।"
    },
    "n5-g-18": {
      "ne": "सँगै फिल्म हेरौँ।"
    },
    "n5-g-19": {
      "ne": "म सधैँ छ बजे उठ्छु।"
    },
    "n5-g-20": {
      "ne": "यो मेरो झोला होइन।"
    },
    "n5-g-21": {
      "ne": "के तपाईं विद्यार्थी हुनुहुन्छ?"
    },
    "n5-g-22": {
      "ne": "म कफी वा चिया पिउँछु।"
    },
    "n5-g-23": {
      "ne": "चिसो भएकोले, म झ्याल बन्द गर्छु।"
    },
    "n5-g-24": {
      "ne": "कृपया मलाई यो कान्जी कसरी पढ्ने सिकाउनुहोस्।"
    },
    "n5-g-25": {
      "ne": "म जान चाहन्छु, तर मसँग समय छैन।"
    },
    "n5-g-26": {
      "ne": "यो महँगो छ, तर स्वादिष्ट छ।"
    },
    "n5-g-27": {
      "ne": "म अझै गृहकार्य गर्दैछु।"
    },
    "n5-g-28": {
      "ne": "मैले अझै दिउँसोको खाना खाएको छैन।"
    },
    "n5-g-29": {
      "ne": "म पाँच बजेसम्म काम गर्छु।"
    },
    "n5-g-30": {
      "ne": "सुत्नुअघि म दाँत माझ्छु।"
    },
    "n5-g-31": {
      "ne": "मसँग चिया पिउनुहुन्न?"
    },
    "n5-g-33": {
      "ne": "के म झ्याल खोलूँ?"
    },
    "n5-g-34": {
      "ne": "म पनि विद्यार्थी हुँ।"
    },
    "n5-g-35": {
      "ne": "मैले दिउँसोको खाना खाइसकेको छु।"
    },
    "n5-g-36": {
      "ne": "यो शान्त सहर हो।"
    },
    "n5-g-37": {
      "ne": "कस्तो राम्रो मौसम छ!"
    },
    "n5-g-38": {
      "ne": "मैले बिहानको खाना नखाई विद्यालय गएँ।"
    },
    "n5-g-39": {
      "ne": "कृपया यहाँ फोटो नखिच्नुहोस्।"
    },
    "n5-g-40": {
      "ne": "मैले औषधि खानुपर्छ।"
    },
    "n5-g-41": {
      "ne": "तपाईं भोलि नआए पनि हुन्छ।"
    },
    "n5-g-42": {
      "ne": "अब घर जानुपर्छ।"
    },
    "n5-g-43": {
      "ne": "हरेक दिन पढ्नुपर्छ।"
    },
    "n5-g-44": {
      "ne": "नियमहरू पालना गर्नुपर्छ।"
    },
    "n5-g-45": {
      "ne": "वसन्त ऋतु आउँदा न्यानो हुन्छ।"
    },
    "n5-g-46": {
      "ne": "मेरो टाउको दुखेको छ।"
    },
    "n5-g-47": {
      "ne": "मौसम राम्रो छ, होइन र?"
    },
    "n5-g-48": {
      "ne": "म सात बजे उठ्छु।"
    },
    "n5-g-49": {
      "ne": "म चलचित्र हेर्न जाँदैछु।"
    },
    "n5-g-50": {
      "ne": "म कफी लिन्छु।"
    },
    "n5-g-51": {
      "ne": "म विद्यालय जाँदैछु।"
    },
    "n5-g-52": {
      "ne": "यो शिक्षकको किताब हो।"
    },
    "n5-g-53": {
      "ne": "के भयो?"
    },
    "n5-g-54": {
      "ne": "म गाउनमा कमजोर छु।"
    },
    "n5-g-55": {
      "ne": "उनी खाना पकाउनमा सिपालु छन्।"
    },
    "n5-g-56": {
      "ne": "मलाई किताब पढ्न मन पर्छ।"
    },
    "n5-g-57": {
      "ne": "खेलहरूमध्ये मलाई फुटबल सबैभन्दा मन पर्छ।"
    },
    "n5-g-58": {
      "ne": "बिरामी भएकोले, म छुट्टी लिन्छु।"
    },
    "n5-g-59": {
      "ne": "कृपया आफ्नो नाम बताउनुहोस्।"
    },
    "n5-g-60": {
      "ne": "म स्याउ खान्छु।"
    },
    "n5-g-61": {
      "ne": "कृपया पानी दिनुहोस्।"
    },
    "n5-g-62": {
      "ne": "म दौडिएँ। तर, समयमा पुग्न सकिनँ।"
    },
    "n5-g-63": {
      "ne": "मैले बिहानको खाना खाएँ। त्यसपछि म स्कुल गएँ।"
    },
    "n5-g-64": {
      "ne": "यो कोठा फराकिलो छ र उज्यालो पनि छ।"
    },
    "n5-g-65": {
      "ne": "मैले हिजो धेरै खाएँ।"
    },
    "n5-g-66": {
      "ne": "म जापान गएको छु।"
    },
    "n5-g-67": {
      "ne": "मलाई चिसो पानी पिउन मन छ।"
    },
    "n5-g-68": {
      "ne": "आइतबार म किताब पढ्ने र संगीत सुन्ने गर्छु।"
    },
    "n5-g-69": {
      "ne": "भित्तामा एउटा चित्र झुण्ड्याइएको छ।"
    },
    "n5-g-70": {
      "ne": "म अहिले टिभी हेरिरहेको छु।"
    },
    "n5-g-71": {
      "ne": "हात धोएपछि खाना खान्छु।"
    },
    "n5-g-72": {
      "ne": "कृपया यहाँ आफ्नो नाम लेख्नुहोस्।"
    },
    "n5-g-73": {
      "ne": "यहाँ चुरोट पिउनु हुँदैन।"
    },
    "n5-g-74": {
      "ne": "तपाईं यहाँ बस्न सक्नुहुन्छ।"
    },
    "n5-g-75": {
      "ne": "म र मेरो साथी पार्क गयौं।"
    },
    "n5-g-76": {
      "ne": "बच्चा हुँदा म प्रायः पौडी खेल्थेँ।"
    },
    "n5-g-77": {
      "ne": "यो परिकार धेरै स्वादिष्ट छ।"
    },
    "n5-g-78": {
      "ne": "म अर्को वर्ष जापान जाने विचारमा छु।"
    },
    "n5-g-79": {
      "ne": "म विद्यार्थी हुँ।"
    },
    "n5-g-80": {
      "ne": "टोकियो ओसाकाभन्दा ठूलो छ।"
    }
  }
}